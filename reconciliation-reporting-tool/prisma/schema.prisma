// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CLIENT
  OPCO
  PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

model User {
  id                   String     @id @default(cuid())
  fullName             String
  email                String     @unique
  mobile               String?
  role                 UserRole
  status               UserStatus @default(ACTIVE)
  passwordHash         String
  failedLoginCount     Int        @default(0)
  lockedAt             DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  opcoAssignments      UserOpCo[]
  partnerAssignments   UserPartner[]
  reportsSubmitted     Report[]   @relation("ReportSubmitter")
  auditLogs            AuditLog[]
  passwordResets       PasswordResetToken[]
  passwordHistory      PasswordHistory[]

  notificationLogs     NotificationLog[] @relation("NotificationRecipient")
  partnerInvoiceUploads PartnerInvoiceUpload[]
}

model OpCo {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  country             String?
  currency            String?
  status              String   @default("Active")
  primaryContactName  String?
  primaryContactEmail String?
  primaryContactPhone String?
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userAssignments      UserOpCo[]
  reports              Report[]
  reconciliations      Reconciliation[]
  invoices             Invoice[]
  collections          Collection[]
}

model Partner {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  defaultCurrency String?
  status        String   @default("Active")
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userAssignments UserPartner[]
  serviceLinks    PartnerService[]
  reports         Report[]
  reconciliations Reconciliation[]
  invoices        Invoice[]
  payments        Payment[]
  partnerInvoiceUploads PartnerInvoiceUpload[]
}

model Service {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  status      String   @default("Active")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partnerLinks PartnerService[]
  reports      Report[]
  reconciliations Reconciliation[]
  invoices        Invoice[]
  partnerInvoiceUploads PartnerInvoiceUpload[]
}

model PartnerService {
  partnerId String
  serviceId String
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([partnerId, serviceId])
}

enum ReportType {
  OPCO_MONTHLY
  PARTNER_MONTHLY
  CLIENT_CONSOLIDATED
  FINAL_RS_CONFIRMATION
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  SUPERSEDED
  ARCHIVED
}

model Report {
  id            String      @id @default(cuid())
  type          ReportType
  month         Int
  year          Int
  serviceId     String
  opcoId        String?
  partnerId     String?
  reference     String?
  fileName      String
  filePath      String
  fileMimeType  String?
  version       Int         @default(1)
  status        ReportStatus @default(SUBMITTED)
  remarks       String?
  submittedAt   DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  submittedById String

  service       Service     @relation(fields: [serviceId], references: [id])
  opco          OpCo?       @relation(fields: [opcoId], references: [id])
  partner       Partner?    @relation(fields: [partnerId], references: [id])
  submittedBy   User        @relation("ReportSubmitter", fields: [submittedById], references: [id])

  @@index([type, month, year, serviceId, opcoId, partnerId])
}

model UserOpCo {
  userId String
  opcoId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opco OpCo @relation(fields: [opcoId], references: [id], onDelete: Cascade)

  @@id([userId, opcoId])
}

model UserPartner {
  userId    String
  partnerId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  name      String              @unique
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  reminders ReminderSetting[]
}

enum ReminderTargetRole {
  OPCO
  PARTNER
}

model ReminderSetting {
  id                String   @id @default(cuid())
  name              String   @unique
  targetRole        ReminderTargetRole
  reportType        ReportType
  daysBeforeDue     Int      @default(3)
  repeatEveryDays   Int?     // null = no repeats
  isActive          Boolean  @default(true)
  templateId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  template          NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model NotificationLog {
  id           String              @id @default(cuid())
  channel      NotificationChannel
  templateName String?
  subject      String?
  body         String
  recipientId  String?
  recipientTo  String?
  status       String              @default("QUEUED")
  error        String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())

  recipient    User?               @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([recipientId])
}

model PartnerInvoiceUpload {
  id           String   @id @default(cuid())
  partnerId    String
  serviceId    String
  month        Int
  year         Int
  reference    String?
  fileName     String
  filePath     String
  fileMimeType String?
  remarks      String?
  submittedAt  DateTime @default(now())
  submittedById String

  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id])
  submittedBy  User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([year, month, partnerId, serviceId])
}

// -------------------------
// Dev 2: Financial Core
// -------------------------

enum ReconciliationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationItemStatus {
  MATCHED
  MISMATCH
  MISSING_IN_OPCO
  MISSING_IN_PARTNER
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSED
  FAILED
  REVERSED
}

model Reconciliation {
  id              String               @id @default(cuid())
  status          ReconciliationStatus @default(PENDING)
  month           Int
  year            Int
  serviceId       String
  opcoId          String?
  partnerId       String?
  remarks         String?

  // Optional linkage to source reports (if/when workflow connects to Dev1 reports).
  opcoReportId    String?
  partnerReportId String?
  clientReportId  String?

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  service         Service              @relation(fields: [serviceId], references: [id])
  opco            OpCo?                @relation(fields: [opcoId], references: [id])
  partner         Partner?             @relation(fields: [partnerId], references: [id])

  items           ReconciliationItem[]
  invoices        Invoice[]

  @@index([year, month, serviceId, opcoId, partnerId])
}

model ReconciliationItem {
  id               String                   @id @default(cuid())
  reconciliationId String
  status           ReconciliationItemStatus

  // Generic identifiers; can be refined once report parsing is implemented.
  reference        String?
  opcoAmount       Decimal?
  partnerAmount    Decimal?
  difference       Decimal?
  meta             Json?

  createdAt        DateTime                 @default(now())

  reconciliation   Reconciliation           @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, status])
}

model Invoice {
  id               String        @id @default(cuid())
  status           InvoiceStatus @default(DRAFT)
  month            Int
  year             Int
  serviceId        String
  opcoId           String
  partnerId        String
  reconciliationId String?

  invoiceNumber    String?
  currency         String?
  amount           Decimal
  remarks          String?

  issuedAt         DateTime?
  dueAt            DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  service          Service       @relation(fields: [serviceId], references: [id])
  opco             OpCo          @relation(fields: [opcoId], references: [id])
  partner          Partner       @relation(fields: [partnerId], references: [id])
  reconciliation   Reconciliation? @relation(fields: [reconciliationId], references: [id])

  collections      Collection[]
  payments         Payment[]

  @@index([year, month, serviceId, opcoId, partnerId])
  @@index([status])
}

model Collection {
  id          String   @id @default(cuid())
  opcoId      String
  invoiceId   String?
  month       Int
  year        Int
  currency    String?
  amount      Decimal
  receivedAt  DateTime @default(now())
  reference   String?
  remarks     String?
  meta        Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opco        OpCo     @relation(fields: [opcoId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([year, month, opcoId])
  @@index([invoiceId])
}

model Payment {
  id          String        @id @default(cuid())
  status      PaymentStatus @default(PENDING)
  partnerId   String
  invoiceId   String?
  month       Int
  year        Int
  currency    String?
  amount      Decimal
  processedAt DateTime?
  reference   String?
  remarks     String?
  meta        Json?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  partner     Partner       @relation(fields: [partnerId], references: [id])
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([year, month, partnerId])
  @@index([invoiceId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  message    String?
  meta       Json?

  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}
